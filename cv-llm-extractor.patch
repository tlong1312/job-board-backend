@@ -0,0 +1,131 @@
+import {
+  LlmExtractError,
+  buildCvPrompt,
+  cvExtractorMode,
+  extractCvInfoWithLlm,
+  normalizeProvince,
+  parseLlmCv,
+} from "./cv-llm-extractor";
+import { LlmProvider } from "../providers/llm.provider";
+
+const CV =
+  "Ứng viên A | Địa điểm: Hà Nội | Kỹ năng | NestJS, TypeScript, Node.js, PostgreSQL, Docker | " +
+  "Kinh nghiệm làm việc | 2023 - 2025 (2 năm), công ty X: phát triển API bằng NestJS và Docker.";
+
+const fakeLlm = (reply: string): LlmProvider => ({
+  model: "fake",
+  completeJson: () => Promise.resolve(reply),
+});
+
+describe("parseLlmCv", () => {
+  it("đọc JSON hợp lệ và đưa kỹ năng về tên chuẩn trong từ điển", () => {
+    const info = parseLlmCv(
+      JSON.stringify({
+        skills: ["Nest.js", "TS", "Docker"],
+        years: 2,
+        province: "Ha Noi",
+        desiredTitle: "Backend Developer",
+      }),
+      CV,
+    );
+    expect(info).not.toBeNull();
+    expect(info!.skills).toEqual(["Docker", "NestJS", "TypeScript"]);
+    expect(info!.years).toBe(2);
+    expect(info!.level).toBe("middle");
+    expect(info!.province).toBe("Hà Nội");
+    expect(info!.desiredTitle).toBe("Backend Developer");
+    expect(info!.extractor).toBe("llm");
+  });
+
+  it("bỏ kỹ năng LLM bịa: không có trong từ điển hoặc không xuất hiện trong CV", () => {
+    const info = parseLlmCv(
+      JSON.stringify({
+        skills: ["Docker", "Kubernetes", "CobolMaster"],
+        years: 1,
+      }),
+      CV,
+    );
+    // Kubernetes có trong từ điển nhưng CV không nhắc tới; CobolMaster không có trong từ điển
+    expect(info!.skills).toEqual(["Docker"]);
+  });
+
+  it("chấp nhận JSON bị bọc trong ```json hoặc kèm vài chữ", () => {
+    const raw =
+      'Đây là kết quả:\n```json\n{"skills": ["Docker"], "years": 2}\n```';
+    expect(parseLlmCv(raw, CV)!.skills).toEqual(["Docker"]);
+  });
+
+  it("trả null khi không phải JSON hoặc thiếu trường skills", () => {
+    expect(parseLlmCv("xin lỗi, tôi không biết", CV)).toBeNull();
+    expect(parseLlmCv('["Docker"]', CV)).toBeNull();
+    expect(parseLlmCv('{"years": 2}', CV)).toBeNull();
+  });
+
+  it("số năm không hợp lệ thì coi như không rút được", () => {
+    expect(parseLlmCv('{"skills": [], "years": -3}', CV)!.years).toBeNull();
+    expect(parseLlmCv('{"skills": [], "years": 99}', CV)!.years).toBeNull();
+    expect(parseLlmCv('{"skills": [], "years": "abc"}', CV)!.years).toBeNull();
+    expect(parseLlmCv('{"skills": [], "years": "2,5"}', CV)!.years).toBe(2.5);
+  });
+
+  it("cấp độ tính từ số năm bằng quy tắc cũ, không hỏi LLM", () => {
+    const level = (years: number) =>
+      parseLlmCv(JSON.stringify({ skills: [], years }), CV)!.level;
+    expect(level(0)).toBe("intern");
+    expect(level(1)).toBe("junior");
+    expect(level(3)).toBe("middle");
+    expect(level(6)).toBe("senior");
+  });
+});
+
+describe("normalizeProvince", () => {
+  it("đưa các cách viết về một dạng chuẩn", () => {
+    expect(normalizeProvince("TP.HCM")).toBe("TP. Hồ Chí Minh");
+    expect(normalizeProvince("Hanoi")).toBe("Hà Nội");
+    expect(normalizeProvince("Hai Phong")).toBe("Hải Phòng");
+    expect(normalizeProvince("  ")).toBeNull();
+    expect(normalizeProvince("Huế")).toBe("Huế");
+  });
+});
+
+describe("extractCvInfoWithLlm", () => {
+  it("trả CvInfo khi LLM trả JSON dùng được", async () => {
+    const info = await extractCvInfoWithLlm(
+      fakeLlm('{"skills":["NestJS"],"years":2}'),
+      CV,
+    );
+    expect(info.skills).toEqual(["NestJS"]);
+  });
+
+  it("ném LlmExtractError khi LLM trả rác (để nơi gọi quay về từ điển)", async () => {
+    await expect(
+      extractCvInfoWithLlm(fakeLlm("không phải json"), CV),
+    ).rejects.toBeInstanceOf(LlmExtractError);
+  });
+});
+
+describe("buildCvPrompt", () => {
+  it("liệt kê kỹ năng chuẩn trong từ điển và cắt CV quá dài", () => {
+    const { system, user } = buildCvPrompt("x".repeat(20000));
+    expect(system).toContain("NestJS");
+    expect(system).toContain("Docker");
+    expect(user.length).toBeLessThan(5100);
+  });
+});
+
+describe("cvExtractorMode", () => {
+  const old = process.env.CV_EXTRACTOR;
+  afterEach(() => {
+    if (old === undefined) delete process.env.CV_EXTRACTOR;
+    else process.env.CV_EXTRACTOR = old;
+  });
+
+  it("mặc định là rules, chỉ bật llm khi đặt đúng", () => {
+    delete process.env.CV_EXTRACTOR;
+    expect(cvExtractorMode()).toBe("rules");
+    process.env.CV_EXTRACTOR = "LLM";
+    expect(cvExtractorMode()).toBe("llm");
+    process.env.CV_EXTRACTOR = "gi-do-khac";
+    expect(cvExtractorMode()).toBe("rules");
+  });
+});
diff --git a/src/modules/ai/cvs/cv-llm-extractor.ts b/src/modules/ai/cvs/cv-llm-extractor.ts
new file mode 100644
index 0000000..facef76
--- /dev/null
+++ b/src/modules/ai/cvs/cv-llm-extractor.ts
@@ -0,0 +1,144 @@
+/**
+ * Rút thông tin từ CV bằng LLM (chạy qua Ollama), để so sánh với cách từ điển + quy tắc
+ * trong cv-extractor.ts.
+ *
+ * LLM chỉ đảm nhận phần "đọc hiểu": kỹ năng, số năm kinh nghiệm, tỉnh/thành, vị trí ứng tuyển.
+ * Kết quả luôn được kiểm lại bằng code thường để mô hình có "bịa" cũng không lọt vào hệ thống:
+ *  - kỹ năng phải đổi được về tên chuẩn trong từ điển VÀ có xuất hiện trong văn bản CV;
+ *  - số năm phải là số hợp lệ (0 đến 50), nếu không thì coi như không rút được;
+ *  - cấp độ KHÔNG hỏi LLM mà tính từ số năm bằng đúng quy tắc cũ (levelFromYears),
+ *    để hai cách rút chỉ khác nhau ở phần đọc hiểu.
+ *
+ * Phần xử lý kết quả (parseLlmCv) là hàm thuần, không gọi mạng nên thử được bằng jest.
+ */
+import { CvInfo, findSkills, levelFromYears } from "./cv-extractor";
+import { SKILL_DICTIONARY } from "./cv-skills.dictionary";
+import { LlmProvider } from "../providers/llm.provider";
+
+/** Chỉ gửi phần đầu CV cho LLM (CV thường ngắn hơn nhiều; giữ trong giới hạn ngữ cảnh). */
+export const MAX_LLM_CV_CHARS = 5000;
+
+export class LlmExtractError extends Error {}
+
+export type CvExtractorMode = "rules" | "llm";
+
+/** Chọn cách rút CV bằng biến môi trường CV_EXTRACTOR=rules|llm (mặc định rules). */
+export function cvExtractorMode(): CvExtractorMode {
+  return (process.env.CV_EXTRACTOR ?? "rules").trim().toLowerCase() === "llm"
+    ? "llm"
+    : "rules";
+}
+
+const SKILL_NAMES = SKILL_DICTIONARY.map((s) => s.name);
+
+export function buildCvPrompt(cvText: string): {
+  system: string;
+  user: string;
+} {
+  const system = [
+    "You extract structured data from a resume written in Vietnamese or English.",
+    "Reply with ONE JSON object and nothing else, in exactly this shape:",
+    '{"skills": string[], "years": number | null, "province": string | null, "desiredTitle": string | null}',
+    "",
+    "Rules:",
+    `- "skills": technical skills the candidate lists or clearly uses. Choose ONLY from this list and spell each exactly as written: ${SKILL_NAMES.join(", ")}.`,
+    '- "years": total years of professional work experience. Add up the job entries. Do NOT count years spent at school. Use 0 if the resume says the candidate has no experience. Use null if it cannot be told.',
+    '- "province": the city or province where the candidate lives or wants to work, for example "Hà Nội" or "TP. Hồ Chí Minh". Use null if not stated.',
+    '- "desiredTitle": the position the candidate is applying for. Use null if not stated.',
+    "- Never invent anything that is not in the resume.",
+  ].join("\n");
+  const user = `Resume:\n"""\n${cvText.slice(0, MAX_LLM_CV_CHARS)}\n"""`;
+  return { system, user };
+}
+
+const PROVINCES: Array<[RegExp, string]> = [
+  [
+    /(?:ho chi minh|hồ chí minh|\bhcm\b|tp\.?\s*hcm|sài gòn|sai gon)/i,
+    "TP. Hồ Chí Minh",
+  ],
+  [/(?:ha noi|hà nội|hanoi)/i, "Hà Nội"],
+  [/(?:hai phong|hải phòng)/i, "Hải Phòng"],
+  [/(?:da nang|đà nẵng)/i, "Đà Nẵng"],
+  [/(?:can tho|cần thơ)/i, "Cần Thơ"],
+];
+
+/** Đưa cách viết tỉnh/thành về một dạng chuẩn; không nhận ra thì giữ nguyên chuỗi đã cắt gọn. */
+export function normalizeProvince(raw: string): string | null {
+  const s = raw.trim();
+  if (!s) return null;
+  for (const [re, name] of PROVINCES) if (re.test(s)) return name;
+  return s.slice(0, 80);
+}
+
+function toYears(v: unknown): number | null {
+  const n = typeof v === "string" ? Number(v.replace(",", ".")) : v;
+  if (typeof n !== "number" || !Number.isFinite(n) || n < 0 || n > 50)
+    return null;
+  return Math.round(n * 10) / 10;
+}
+
+function parseJsonObject(raw: string): Record<string, unknown> | null {
+  const tryParse = (s: string): Record<string, unknown> | null => {
+    try {
+      const v: unknown = JSON.parse(s);
+      return v !== null && typeof v === "object" && !Array.isArray(v)
+        ? (v as Record<string, unknown>)
+        : null;
+    } catch {
+      return null;
+    }
+  };
+  const direct = tryParse(raw.trim());
+  if (direct) return direct;
+  // Có mô hình bọc JSON trong ```json ... ``` hoặc thêm vài chữ: lấy đoạn từ { đầu tới } cuối
+  const start = raw.indexOf("{");
+  const end = raw.lastIndexOf("}");
+  return start !== -1 && end > start
+    ? tryParse(raw.slice(start, end + 1))
+    : null;
+}
+
+/** Biến câu trả lời thô của LLM thành CvInfo đã kiểm tra; trả null nếu không dùng được. */
+export function parseLlmCv(raw: string, cvText: string): CvInfo | null {
+  const obj = parseJsonObject(raw);
+  if (!obj || !("skills" in obj)) return null;
+
+  const mentioned = findSkills(cvText);
+  const claimed = Array.isArray(obj.skills)
+    ? obj.skills.filter((s): s is string => typeof s === "string")
+    : [];
+  const skills = [...new Set(claimed.flatMap((s) => findSkills(s)))]
+    .filter((s) => mentioned.includes(s))
+    .sort((a, b) => a.localeCompare(b));
+
+  const years = toYears(obj.years);
+  const province =
+    typeof obj.province === "string" ? normalizeProvince(obj.province) : null;
+  const title =
+    typeof obj.desiredTitle === "string" ? obj.desiredTitle.trim() : "";
+
+  return {
+    skills,
+    mentionedSkills: mentioned,
+    years,
+    level: levelFromYears(years, cvText),
+    province,
+    desiredTitle: title ? title.slice(0, 120) : null,
+    extractor: "llm",
+  };
+}
+
+export async function extractCvInfoWithLlm(
+  llm: LlmProvider,
+  cvText: string,
+): Promise<CvInfo> {
+  const { system, user } = buildCvPrompt(cvText);
+  const raw = await llm.completeJson(system, user);
+  const info = parseLlmCv(raw, cvText);
+  if (!info) {
+    throw new LlmExtractError(
+      `LLM trả về JSON không dùng được: ${raw.slice(0, 120)}`,
+    );
+  }
+  return info;
+}
