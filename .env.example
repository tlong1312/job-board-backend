PORT=3000
# Môi trường chạy: để trống hoặc "development" khi dev, "production" khi triển khai
NODE_ENV=development
# Các origin được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy.
# Dev có thể để trống (cho mọi origin). Production phải liệt kê, ví dụ: https://jobboard.example.com
CORS_ORIGINS=

# PostgreSQL (khớp docker-compose.yml)
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASS=123456
DB_NAME=job_board_db

# RabbitMQ (hàng đợi gửi email khi đổi trạng thái hồ sơ)
RABBITMQ_URL=amqp://localhost:5673

# Redis (cache danh sách tin và giới hạn tần suất)
REDIS_HOST=localhost
REDIS_PORT=6381

# Email: dev dùng Mailpit trong docker-compose (xem thư ở http://localhost:8026).
# Khi dùng SMTP thật, đổi các giá trị dưới đây (ví dụ Brevo: smtp-relay.brevo.com, cổng 587).
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Job Board <no-reply@jobboard.local>

# Khoá ký JWT: BẮT BUỘC tự sinh chuỗi ngẫu nhiên riêng
# Sinh nhanh:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_REFRESH_SECRET=chuoi-ngau-nhien-khac-voi-access-secret
