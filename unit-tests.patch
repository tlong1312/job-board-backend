+      expect.any(Function),
+    );
+    expect(dataSource.query).toHaveBeenCalledTimes(1);
+  });
+
+  it("cache trúng thì không chạm DB", async () => {
+    redis.remember.mockResolvedValue([{ id: 1 }]);
